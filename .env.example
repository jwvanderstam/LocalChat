# LocalChat Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME=LocalChat
APP_ENV=development  # development, staging, production
DEBUG=True
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Server Configuration
HOST=localhost
PORT=5000

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
# On deployment, restrict this file: chmod 600 .env  (owner read/write only)
# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-random-jwt-secret-in-production
# How long a browser session lasts before re-login. There is no refresh token, so
# this is literally how often you will be asked to sign in again. Raise it for fewer
# interruptions, lower it to shorten how long a stolen token stays useful.
JWT_ACCESS_TOKEN_EXPIRES=7200  # 2 hours in seconds

# Admin user password for /api/auth/login  (required - no login possible if unset)
ADMIN_PASSWORD=change-this-to-a-strong-password

# Fernet key encrypting OAuth tokens, message content and long-term memories at
# rest. REQUIRED when APP_ENV=production — startup aborts without it, because an
# unset or malformed key silently degrades to storing all of that in plain text.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Note this does NOT cover document text: see SECURITY.md for why it cannot.
ENCRYPTION_KEY=

# Rate Limiting (Format: "X per Y" where Y: second, minute, hour, day)
RATELIMIT_ENABLED=True
RATELIMIT_CHAT=10 per minute
RATELIMIT_UPLOAD=5 per hour
RATELIMIT_MODELS=20 per minute
RATELIMIT_GENERAL=60 per minute
# Login is the one endpoint where repetition is the attack — keep this tight.
RATELIMIT_LOGIN=10 per minute

# Comma-separated proxy addresses, CIDRs, or "*" that are allowed to set
# X-Forwarded-For. Empty (the default) means no proxy is believed and every
# limit keys on the socket peer — correct when nothing fronts the app.
# Behind a reverse proxy this MUST be set, or all callers share one bucket.
# docker-compose.nginx.yml sets it for you.
TRUSTED_PROXY_IPS=

# Logging
# Where logs go: any of console, file, syslog (comma-separated).
#   console — stdout/stderr, collected by the container runtime
#   file    — rotating local log; survives container recreation (docker logs does
#             not) and records DEBUG where the console records INFO
#   syslog  — ships to a SOC/SIEM collector
LOG_SINKS=console,file
# Rotation ceiling: LOG_MAX_BYTES * (1 + LOG_BACKUP_COUNT) = 20 MB by default.
# Log volume follows request volume, which an attacker controls — this is what
# stops a request flood from filling the disk.
LOG_MAX_BYTES=4194304
LOG_BACKUP_COUNT=4
# Only used when 'syslog' is in LOG_SINKS. "host:port", or a path like /dev/log.
LOG_SYSLOG_ADDRESS=
LOG_SYSLOG_PROTOCOL=udp
# Floor for libraries that log about their own internals (httpx, huggingface,
# markdown). They were the bulk of the log file: noise that crowds out the
# application's own records inside a bounded rotation, and that never passes
# through this project's log sanitiser. Set to DEBUG while diagnosing a library.
LOG_THIRD_PARTY_LEVEL=WARNING

# CORS Settings (if needed for external access)
CORS_ENABLED=False
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL Connection
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your-password-here
PG_DB=rag_db

# Connection Pool
DB_POOL_MIN_CONN=2
DB_POOL_MAX_CONN=10
DB_POOL_TIMEOUT=5

# ============================================================================
# OLLAMA CONFIGURATION
# ============================================================================
# Where the application looks for Ollama.
#
# Running the stack with `docker compose up -d` — the supported deployment —
# this value is NOT used: docker-compose.yml sets OLLAMA_BASE_URL=http://ollama:11434
# in the app service's `environment:`, which overrides anything in .env. Editing
# the line below will not repoint a containerised app; change it in the compose
# file, or override the whole service.
#
# It applies to the host-run dev path (`python app.py`), which reaches the
# stack's Ollama through the published port below.
OLLAMA_BASE_URL=http://localhost:11434
# Host port the ollama container publishes on, for that host-run path. Move it if
# something else already owns 11434 — a natively installed Ollama, typically.
# Bound to BIND_HOST (127.0.0.1 by default), so it is not reachable off-host.
OLLAMA_BIND_PORT=11434
OLLAMA_TIMEOUT=120
OLLAMA_DEFAULT_MODEL=llama3.1:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
# Preferred chat model selected at startup (prefix match, falls back to first available)
DEFAULT_MODEL=llama3.1
# Embedding request timeout — raise if CPU cold-start exceeds default
OLLAMA_EMBED_TIMEOUT=300
# Gunicorn worker timeout — must be >= OLLAMA_EMBED_TIMEOUT
GUNICORN_TIMEOUT=300

# ============================================================================
# RAG CONFIGURATION
# ============================================================================
# Chunking Settings
CHUNK_SIZE=768
CHUNK_OVERLAP=128
CHUNK_SEPARATORS=\n\n,\n,. , ,

# Retrieval Settings
TOP_K_RESULTS=15
MIN_SIMILARITY_THRESHOLD=0.25
# Floor on the cross-encoder's own judgement, applied after reranking. Embedding
# similarity has no absolute meaning -- an arithmetic question scored 0.61 against
# an unrelated tender document -- while the cross-encoder scored the same passages
# -11.4 and +0.81. Set well below zero so only the plainly irrelevant is dropped.
RERANK_MIN_SCORE=-5.0
# When nothing clears the floor, keep this many of the best and mark them as weak
# rather than answering with no sources and no explanation.
RERANK_LOW_RELEVANCE_LIMIT=3
RERANK_RESULTS=True

# Processing
MAX_WORKERS=4
MAX_UPLOAD_SIZE_MB=16

# ============================================================================
# LLM CONFIGURATION
# ============================================================================
DEFAULT_TEMPERATURE=0.0
# Token context window sent to Ollama — tune this to your GPU + model (see
# src/config.py's comment for VRAM-per-context-size guidance). MAX_CONTEXT_LENGTH
# is a separate, character-based limit for prompt formatting that defaults to
# OLLAMA_NUM_CTX x 3 — leave it unset unless you specifically need to override it.
OLLAMA_NUM_CTX=8192
STREAM_RESPONSES=True

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=.pdf,.txt,.docx,.md
MAX_FILE_SIZE=16777216  # 16MB in bytes

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Sinks, rotation and syslog are configured in the Logging block further up.
# LOG_FILE is the path the `file` sink writes to; LOG_FORMAT is `text` or `json`.
LOG_FILE=logs/app.log
LOG_FORMAT=text

# ============================================================================
# MONITORING & HEALTH CHECKS
# ============================================================================
HEALTH_CHECK_ENABLED=True
METRICS_ENABLED=False
# REQUIRED for non-localhost deployments: set a strong random token to protect
# the /api/metrics endpoint. Without this, metrics are publicly accessible.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
METRICS_TOKEN=

# ============================================================================
# REDIS CONFIGURATION (Optional - for caching/sessions)
# ============================================================================
REDIS_ENABLED=False
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================================
# EMAIL CONFIGURATION (Optional - for notifications)
# ============================================================================
EMAIL_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@localchat.local

# ============================================================================
# DEPLOYMENT SETTINGS
# ============================================================================
# Production settings
WORKERS=4  # Gunicorn workers
WORKER_CLASS=sync  # sync, gevent, eventlet
WORKER_TIMEOUT=120

# ============================================================================
# CONTAINER RESOURCE LIMITS (docker-compose only; MM-2)
# ============================================================================
# Ceilings, not allocations — a service only uses what it needs. They exist so
# one container cannot starve the rest of the host. Kubernetes deployments get
# the equivalent from the Helm chart's `resources:` and ignore these.
#
# Defaults are sized for a ~16 GB host. Raise them on a bigger machine; on a
# smaller one lower OLLAMA_MEM_LIMIT first, since it is by far the largest.
#
# Trade-off worth knowing: a memory limit turns "slow" into "killed". Without
# one, a model too large for VRAM spills to CPU and runs slowly; with one, the
# OOM killer stops it mid-generation instead. That protects PostgreSQL, which
# is the point — but set the limit generously so only real runaway hits it.

# Ollama — the largest consumer. Caps host RAM and CPU; VRAM residency is
# capped separately by OLLAMA_MAX_LOADED_MODELS in docker-compose.yml.
OLLAMA_MEM_LIMIT=8g
OLLAMA_CPU_LIMIT=12

# Application — ingestion (chunking + batch embedding) is the spiky path.
APP_MEM_LIMIT=3g
APP_CPU_LIMIT=8

# PostgreSQL. Note there is no "reservation" knob: Docker has no way to
# guarantee a container memory. What protects the database is the ceilings on
# the services above, which stop them consuming the whole host.
DB_MEM_LIMIT=2g
DB_CPU_LIMIT=4

# Redis — keep REDIS_MAXMEMORY below REDIS_MEM_LIMIT. Redis then evicts its
# own coldest keys and keeps serving, rather than being OOM-killed by Docker.
REDIS_MEM_LIMIT=512m
REDIS_CPU_LIMIT=2
REDIS_MAXMEMORY=384mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# MCP domain servers (only with `--profile mcp`) — thin HTTP wrappers.
MCP_MEM_LIMIT=512m
MCP_CPU_LIMIT=2
